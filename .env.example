# Copy to .env and fill in. .env is gitignored — never commit real values.

### Neo4j (identity graph, backs Cartography) ###
NEO4J_AUTH=neo4j/changeme-local-only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-only

### Cartography ###
# GitHub personal access token, read-only, public repo scope only.
# Use a dedicated low-privilege token — never a primary/admin credential.
CARTOGRAPHY_GITHUB_TOKEN=
CARTOGRAPHY_GITHUB_URL=https://api.github.com/graphql

### AIM (Agent Identity Management) self-hosted minimal stack ###
# Postgres user/db are fixed by AIM's own backend image (postgres/identity) —
# only secrets are configurable here. Generate real values with e.g.
# `openssl rand -hex 16` / `openssl rand -hex 32` / `openssl rand -base64 32`.
AIM_POSTGRES_PASSWORD=changeme-local-only
AIM_POSTGRES_PORT=5432
AIM_REDIS_PASSWORD=changeme-local-only
AIM_REDIS_PORT=6379
AIM_BACKEND_PORT=8080
AIM_FRONTEND_PORT=3000
AIM_JWT_SECRET=changeme-local-only
AIM_KEYVAULT_MASTER_KEY=changeme-local-only
# AIM_ADMIN_EMAIL is NOT read by the real bootstrap process — `aim-bootstrap
# --default` always creates admin@opena2a.org. See aim/README-local-build.md.
# Password policy: upper+lower+digit+special char, or bootstrap rejects it.
AIM_ADMIN_EMAIL=admin@demo-corp.test
AIM_ADMIN_PASSWORD=changeme-local-only

### Synthetic data generator ###
SYNTH_SEED=1337
# Identity-side generator (generate_identities.py) — number of fake users.
SYNTH_MAX_USERS=25
# Agent-side generator (generate_agents.py) — the fleet is a fixed roster,
# so this only matters if you shrink it below the roster's own length.
SYNTH_MAX_AGENTS=6
SYNTH_FAKE_DOMAIN=demo-corp.test

### Unifying UI (Phase 5) ###
# Vite app in ui/ — reads this same root .env (see ui/vite.config.ts envDir).
# VITE_* vars are baked into the client-side JS bundle at build time, so
# this is a deliberate tradeoff, not an oversight: CLAUDE.md's success
# criteria require the demo to run "without touching a keyboard mid-demo",
# and this app only ever binds to localhost on a lab this repo's own
# guardrails already declare non-production / synthetic-data-only.
#
# The AIM credentials below are a DEDICATED "ui-viewer" account (role:
# manager — the minimum role that can read /security/violations; there's
# no lower "read-only" role that can), not the real admin account. It can
# read agents/violations but cannot administer AIM (verified: PUT
# /admin/enforcement-settings returns 403 for it). Never bake the real
# AIM_ADMIN_PASSWORD in here.
UI_PORT=5173
VITE_NEO4J_URI=bolt://localhost:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=changeme-local-only
VITE_AIM_API_URL=http://localhost:8090
VITE_AIM_VIEWER_EMAIL=ui-viewer@demo-corp.test
VITE_AIM_VIEWER_PASSWORD=changeme-local-only
