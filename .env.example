# Copy to .env and fill in. .env is gitignored — never commit real values.

### Neo4j (identity graph, backs Cartography) ###
NEO4J_AUTH=neo4j/changeme-local-only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-only

### Cartography ###
# GitHub personal access token, read-only, public repo scope only.
# Use a dedicated low-privilege token — never a primary/admin credential.
CARTOGRAPHY_GITHUB_TOKEN=
CARTOGRAPHY_GITHUB_URL=https://api.github.com/graphql

### AIM (Agent Identity Management) self-hosted minimal stack ###
AIM_POSTGRES_USER=aim
AIM_POSTGRES_PASSWORD=changeme-local-only
AIM_POSTGRES_DB=aim
AIM_POSTGRES_PORT=5432
AIM_REDIS_PORT=6379
AIM_BACKEND_PORT=8080
AIM_FRONTEND_PORT=3000
AIM_JWT_SECRET=changeme-local-only

### Synthetic data generator ###
SYNTH_SEED=1337
SYNTH_MAX_EVENTS=500
SYNTH_FAKE_DOMAIN=demo-corp.test

### Unifying UI ###
UI_PORT=5173
NEXT_PUBLIC_NEO4J_URI=bolt://localhost:7687
NEXT_PUBLIC_NEO4J_USER=neo4j
NEXT_PUBLIC_AIM_API_URL=http://localhost:8080
